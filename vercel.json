{
  "buildCommand": "pnpm build",
  "routes": [
    { "src": "/api/(.*)", "headers": { "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS", "Access-Control-Allow-Headers": "Content-Type, Authorization" }, "continue": true },
    { "src": "/api/(.+)", "dest": "/api/[...route]", "check": true },
    { "src": "/((?!api).*)", "dest": "/index.html", "check": true }
  ]
}
