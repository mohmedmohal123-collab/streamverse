{
  "buildCommand": "pnpm build",
  "outputDirectory": "src/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path((?!assets/|icons/|manifest.json|favicon.ico|sw.js|env.json).*)",
      "destination": "/index.html"
    }
  ]
}